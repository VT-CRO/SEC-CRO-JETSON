<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">  
  <ros2_control name="Crobot" type="system">
    <hardware>
      <xacro:if value="$(arg sim_mode)">
        <!-- TODO: Determine if this gazebo plugin is right -->
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg sim_mode)">
        <plugin>crobot_hardware/CrobotHardware</plugin>
      </xacro:unless>
    </hardware>
    <joint name="front_left_ankle_joint">
      <command_interface name="position"/>
      <state_interface   name="position"/>
    </joint>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface   name="velocity"/>
    </joint>
    <joint name="front_right_ankle_joint">
      <command_interface name="position"/>
      <state_interface   name="position"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface   name="velocity"/>
    </joint>
    <joint name="mid_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface   name="velocity"/>
    </joint>
    <joint name="mid_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface   name="velocity"/>
    </joint>
    <joint name="rear_left_ankle_joint">
      <command_interface name="position"/>
      <state_interface   name="position"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface   name="velocity"/>
    </joint>
    <joint name="rear_right_ankle_joint">
      <command_interface name="position"/>
      <state_interface   name="position"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface   name="velocity"/>
    </joint>
  </ros2_control>
</robot>