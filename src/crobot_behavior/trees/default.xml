<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <SequenceStar>

      <!-- ═══════════════════════════════════════════════════════════════
           BUTTON TASK
           1. Nav2 drives the robot to the button position.
           2. PressButton takes over cmd_vel directly:
              - drives forward slowly into the button 3 times
              - briefly reverses between each press
              - backs up to clear the area when done
           3. SequenceStar moves on to the next task.
           ═══════════════════════════════════════════════════════════════ -->

      <SweeperControl sweeper_command = "2.25"/>

      <GoToPose name="navigate_to_button"
                goalPoses="0.7571644186973572,-0.009385672397911549,0.0"/>

      <PressButton name="press_button"
                   num_presses="3"
                   forward_speed="0.10"
                   forward_secs="1.5"
                   backward_speed="0.10"
                   backward_secs="1.5"
                   backup_secs="4.0"/>

      <SweeperControl sweeper_command = "1.0"/>

    </SequenceStar>
  </BehaviorTree>
</root>