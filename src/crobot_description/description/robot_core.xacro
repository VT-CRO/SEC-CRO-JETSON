<?xml version="1.0"?>
<robot xmlns:xacro="https://www.ros.org/wiki/xacro">

  <xacro:include filename="inertials_macros.xacro"/>
  <xacro:include filename="materials.xacro"/>

  <!-- Parameters -->
  <xacro:property name="body_length"  value="0.3048"/>
  <xacro:property name="body_width"   value="0.25"/>
  <xacro:property name="body_height"  value="0.10"/>
  <xacro:property name="drivetrain_height" value="0.02"/>
  <xacro:property name="wheel_radius" value="0.035"/>
  <xacro:property name="wheel_width"  value="0.0408"/>
  <xacro:property name="wheel_mass"   value="0.15"/>
  <xacro:property name="omni_wheel_mass" value="0.12"/>
  <xacro:property name="chassis_mass" value="2.0"/>
  <xacro:property name="ankle_mass"   value="0.05"/>

  <xacro:property name="x_front" value="0.115"/>
  <xacro:property name="x_mid"   value="0.0"/>
  <xacro:property name="x_back"  value="-0.115"/>
  <xacro:property name="y_left"  value="0.075"/>
  <xacro:property name="y_right" value="-0.075"/>

  <!-- base_link is the robot origin (center of chassis) -->
  <link name="base_link"/>

  <!-- CHASSIS (link frame at its center) -->
  <link name="chassis">
    <visual>
      <!-- visual origin relative to chassis link frame (center) -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>

    <xacro:inertial_box mass="${chassis_mass}" x="${body_length}" y="${body_width}" z="${body_height}">
      <!-- inertia origin at chassis link frame (center) -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- attach chassis to base_link: chassis frame is coincident with base_link -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- MACRO: ankle mount and wheel.
       Design: the ankle_joint places the ankle_mount link frame at the wheel center (relative to base_link).
       The wheel link frame is at wheel center (joint origin 0 0 0). Visual/collision/inertial inside wheel are centered there. -->
  <xacro:macro name="ankle_and_wheel" params="name xpos ypos is_omni">

    <!-- ankle_mount link: its link frame = wheel center (so visual/inertial are relative to that center) -->
    <link name="${name}_ankle_mount">
      <visual>
        <origin xyz="0 0 ${-drivetrain_height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.03 ${drivetrain_height}"/>
        </geometry>
        <material name="silver"/>
      </visual>

      <!-- inertial for the mount centered at the link frame -->
      <xacro:inertial_box mass="${ankle_mass}" x="0.03" y="0.03" z="${drivetrain_height}">
        <origin xyz="0 0 ${-drivetrain_height / 2.0}" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>

    <!-- ankle joint: parent = base_link, child = ankle_mount.
         origin places the ankle_mount frame at the wheel center in base_link coordinates. -->
    <joint name="${name}_ankle_joint" type="revolute">
      <parent link="base_link"/>
      <child  link="${name}_ankle_mount"/>
      <origin xyz="${xpos} ${ypos} ${-body_height/2.0}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <!-- ±90° -->
      <limit lower="${-pi/2.0}" upper="${pi/2.0}" effort="5.0" velocity="2.0"/>
    </joint>

    <!-- wheel link: frame at wheel center.
         cylinder length is along Z by URDF default, so rotate to align axle with Y (rpy = 1.5708 0 0).
         Visual/collision/inertial centered at link frame (wheel center). -->
    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="${is_omni == 'true' and 'black' or 'blue'}"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <xacro:inertial_cylinder mass="${is_omni == 'true' and omni_wheel_mass or wheel_mass}"
                              length="${wheel_width}" radius="${wheel_radius}">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <!-- wheel spin joint: parent = ankle_mount, child = wheel, origin set to 0 0 0 because wheel frame = ankle_mount frame (wheel center).
         axis is Y so wheel spins around its axle. -->
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="${name}_ankle_mount"/>
      <child  link="${name}_wheel"/>
      <origin xyz="0 0 ${-drivetrain_height - wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- FRONT LEFT / RIGHT (differential, with ankle) -->
  <xacro:ankle_and_wheel name="front_left"  xpos="${x_front}" ypos="${y_left}"  is_omni="false"/>
  <xacro:ankle_and_wheel name="front_right" xpos="${x_front}" ypos="${y_right}" is_omni="false"/>

  <!-- MID wheels: do not steer. Use a fixed mount whose link frame is placed at the wheel center,
       and a wheel joint from that mount to the wheel where origin=0 0 0. -->
  <!-- MID LEFT -->
  <link name="mid_left_mount">
    <visual>
      <origin xyz="0 0 ${-drivetrain_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 ${drivetrain_height}"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <xacro:inertial_box mass="${ankle_mass}" x="0.025" y="0.025" z="${drivetrain_height}">
      <origin xyz="0 0 ${-drivetrain_height / 2.0}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="mid_left_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="mid_left_mount"/>
    <origin xyz="${x_mid} ${y_left} ${-body_height/2.0}" rpy="0 0 0"/>
  </joint>

  <link name="mid_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="${omni_wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="mid_left_wheel_joint" type="continuous">
    <parent link="mid_left_mount"/>
    <child  link="mid_left_wheel"/>
    <origin xyz="0 0 ${-drivetrain_height - wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- MID RIGHT -->
  <link name="mid_right_mount">
    <visual>
      <origin xyz="0 0 ${-drivetrain_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 ${drivetrain_height}"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <xacro:inertial_box mass="${ankle_mass}" x="0.025" y="0.025" z="${drivetrain_height}">
      <origin xyz="0 0 ${-drivetrain_height / 2.0}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="mid_right_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="mid_right_mount"/>
    <origin xyz="${x_mid} ${y_right} ${-body_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <link name="mid_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="${omni_wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="mid_right_wheel_joint" type="continuous">
    <parent link="mid_right_mount"/>
    <child  link="mid_right_wheel"/>
    <origin xyz="0 0 ${-drivetrain_height - wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <gazebo reference="mid_left_wheel">
    <mu1>1.0</mu1>
    <mu2>0.0</mu2> 
  </gazebo>

  <gazebo reference="mid_right_wheel">
    <mu1>1.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- BACK LEFT / RIGHT -->
  <xacro:ankle_and_wheel name="back_left"  xpos="${x_back}" ypos="${y_left}"  is_omni="false"/>
  <xacro:ankle_and_wheel name="back_right" xpos="${x_back}" ypos="${y_right}" is_omni="false"/>

</robot>