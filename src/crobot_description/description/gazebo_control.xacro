<?xml version="1.0"?>
<robot xmlns:xacro="https://www.ros.org/wiki/xacro">

    <gazebo>
        <!-- <plugin name="gz::sim::systems::MecanumDrive" filename="libgz-sim8-mecanum-drive-system.so"> -->
        <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
            <!-- ROS 2 integration -->

            <!-- Frames -->
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <tf_topic>tf</tf_topic>
            <odom_topic>odom</odom_topic>
            <topic>cmd_vel</topic>

            <!-- Odometry -->
            <odometry_publish_frequency>50</odometry_publish_frequency>

            <!-- Wheel configuration -->
            <front_left_joint>front_left_wheel_joint</front_left_joint>
            <front_right_joint>front_right_wheel_joint</front_right_joint>
            <back_left_joint>back_left_wheel_joint</back_left_joint>
            <back_right_joint>back_right_wheel_joint</back_right_joint>

            <!-- Wheel parameters -->
            <wheel_separation>0.5</wheel_separation> <!-- Distance between left and right wheels -->
            <wheelbase>0.4</wheelbase> <!-- Distance between front and rear wheels -->
            <wheel_radius>0.1</wheel_radius> <!-- Radius of the wheels -->

            <!-- Velocity limits -->
            <!-- <max_linear_velocity>2.0</max_linear_velocity>
            <max_angular_velocity>1.0</max_angular_velocity> -->
        </plugin>
    </gazebo>

</robot>
