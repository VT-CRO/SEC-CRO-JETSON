<root BTCPP_format="4" >
    <BehaviorTree ID="MainTree">
        <RetryUntilSuccessful name="retry" num_attempts="-1">
            <SequenceWithMemory name="root_sequence">

                <SubTree ID="Init"/>
                <SubTree ID="Beacon"/>
                <SubTree ID="Sweep"/>
                <SubTree ID="End"/>
            </SequenceWithMemory>
        </RetryUntilSuccessful name="retry">
    </BehaviorTree>

    <BehaviorTree ID="Init">
        <Sequence name="init_sequence">
            <Start name="start"/>
            <!-- <SetBeacon name="setbeacon" setBeacon="true"/> -->
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Beacon">
        <Sequence name="beacon_sequence">
            <GoToPose name="goToPose1" goalPoints="15,155,0;52,149,0;56,176,90"/>
            <GoToPose name="goToPose2" goalPoints="56,176,90;56,176,0"/>
            <GoToPose name="goToPose3" goalPoints="56,176,0;56,215,0"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Sweep">
        <Sequence name="sweep_sequence">
            <GoToPose name="goToPose1" goalPoints="56,215,0;56,168,0"/>
            <GoToPose name="goToPose2" goalPoints="56,168,0;80,168,0"/>
            <!-- Do bin pickup -->
        </Sequence>
    </BehaviorTree>

    <!-- <BehaviorTree ID="PostSweep">
        <Sequence name="post_sweep_sequence">

        </Sequence>
    </BehaviorTree> -->

    <BehaviorTree ID="End">
        <Sequence name="end_sequence">
            <KeepRunningUntilFailure name="infinite_loop">
                <GoToPose name="goToPose3" goalPoints="56,176,90;56,176,90"/>
            </KeepRunningUntilFailure>
        </Sequence>
    </BehaviorTree>
</root>